<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="1-create-workshops-and-bookings" author="workshop-portal">
        <createTable tableName="workshop">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="title" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="starts_at" type="TIMESTAMP"/>
            <column name="capacity" type="INT"><constraints nullable="false"/></column>
            <column name="booked_seats" type="INT"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="seat_booking">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="attendee_name" type="VARCHAR(255)"/>
            <column name="attendee_email" type="VARCHAR(255)"/>
            <column name="workshop_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_booking_workshop" referencedTableName="workshop" referencedColumnNames="id"/></column>
            <column name="status" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="seat_booking" indexName="idx_seat_booking_email"><column name="attendee_email"/></createIndex>
        <createIndex tableName="seat_booking" indexName="idx_seat_booking_workshop"><column name="workshop_id"/></createIndex>
    </changeSet>
    <changeSet id="2-add-external-event-metadata" author="workshop-portal">
        <addColumn tableName="workshop">
            <column name="external_source_key" type="VARCHAR(512)"/>
            <column name="source_url" type="VARCHAR(1000)"/>
            <column name="source_date_text" type="VARCHAR(255)"/>
        </addColumn>
        <addUniqueConstraint tableName="workshop" columnNames="external_source_key" constraintName="uq_workshop_external_source_key"/>
    </changeSet>
    <changeSet id="3-create-portal-notifications" author="workshop-portal">
        <createTable tableName="portal_notification">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="recipient_email" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="kind" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="message" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="portal_notification" indexName="idx_portal_notification_recipient">
            <column name="recipient_email"/><column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
